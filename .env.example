# PostgreSQL
POSTGRES_USER=newtonite
POSTGRES_PASSWORD=newtonite
POSTGRES_DB=newtonite
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://newtonite:newtonite@postgres:5432/newtonite
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
BACKEND_PORT=8000

# Frontend (browser origin; API is same-origin via nginx/Vite proxy)
VITE_API_BASE_URL=/api
FRONTEND_PORT=8080
